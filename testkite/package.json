{
  "name": "testkite",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "openapi:gen": "pnpm -F @testkite/contract openapi:gen",
    "openapi:check": "pnpm openapi:gen && git diff --exit-code -- packages/contract/openapi.json",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "vitest": "^3.0.0",
    "@types/node": "^22.10.0"
  }
}
