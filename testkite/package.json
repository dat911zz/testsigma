{
  "name": "testkite",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:tools",
    "test:tools": "vitest run tools --exclude 'tools/lint-fixtures/**'",
    "lint": "eslint apps packages",
    "lint:cycles": "madge --circular --no-spinner packages/*/src apps/*/src",
    "openapi:gen": "pnpm -F @testkite/contract openapi:gen",
    "openapi:check": "pnpm openapi:gen && git diff --exit-code -- packages/contract/openapi.json",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.9",
    "eslint-import-resolver-typescript": "^4.4",
    "eslint-plugin-boundaries": "^7.2",
    "madge": "^8",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.68",
    "vitest": "^3.0.0"
  }
}
